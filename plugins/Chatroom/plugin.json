{
    "id": "chatroom",
    "name": "聊天室",
    "name_en": "Chat room",
    "description": "播放页本片讨论。关掉后入口消失。不是弹幕，也不走弹幕表。",
    "description_en": "Per-title chat on the play page. Not danmaku and not the danmaku table.",
    "version": "1.1.0",
    "enabled": true,
    "capability": "ready",
    "group": "play",
    "provider": "Plugins\\Chatroom\\ChatroomServiceProvider",
    "admin": {
        "extra_pages": {
            "chatroom": {
                "title": "chatroom.cfg_title",
                "hint": "chatroom.cfg_hint",
                "fields": [
                    {
                        "name": "chatroom_enabled",
                        "label": "chatroom.cfg_on",
                        "type": "select",
                        "options": {
                            "1": "ui.on_switch",
                            "0": "ui.off_switch"
                        }
                    },
                    {
                        "name": "chatroom_login",
                        "label": "chatroom.cfg_login",
                        "type": "select",
                        "options": {
                            "0": "ui.no",
                            "1": "ui.yes"
                        }
                    }
                ]
            }
        },
        "modules": {
            "chat_messages": {
                "title": "聊天室",
                "hint": "播放页本片讨论。后台只审显示、隐藏或删除，不能手添。",
                "model": "Plugins\\Chatroom\\Models\\ChatMessage",
                "search": "text",
                "view": "chatroom::admin.board",
                "handler": "Plugins\\Chatroom\\Services\\ChatroomAdmin",
                "desks": ["messages", "settings"],
                "default_desk": "messages",
                "fields": [
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "video_id",
                    "name",
                    "text",
                    "report",
                    "status",
                    "created_at"
                ]
            }
        },
        "sidebar_fold": {
            "content": [
                {
                    "url": "/admin/video/chat_messages",
                    "icon": "comments",
                    "label": "nav.chatroom"
                }
            ]
        },
        "catalog": {
            "more.interact": [
                {
                    "url": "/admin/video/chat_messages",
                    "label": "item.chatroom",
                    "hint": "hint.chatroom",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {
                "url": "/admin/video/chat_messages?desk=settings",
                "label": "item.config_chatroom"
            }
        ]
    }
}
