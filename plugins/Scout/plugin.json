{
    "id": "scout",
    "name": "全文搜索",
    "name_en": "Full-text search",
    "description": "Laravel Scout 全文搜索。默认 database 驱动（表内检索）；可改 Meilisearch。关掉后前台关键词回退 LIKE。",
    "description_en": "Laravel Scout full-text search. Default database driver; optional Meilisearch. Falls back to LIKE when off.",
    "version": "1.0.0",
    "enabled": true,
    "capability": "ready",
    "group": "site",
    "provider": "Plugins\\Scout\\ScoutServiceProvider",
    "admin": {
        "extra_pages": {
            "scout": {
                "title": "scout.cfg_title",
                "hint": "scout.cfg_hint",
                "fields": [
                    {
                        "name": "scout_search_enabled",
                        "label": "scout.cfg_enable",
                        "type": "select",
                        "options": {
                            "0": "scout.cfg_like",
                            "1": "ui.yes"
                        }
                    },
                    {
                        "name": "scout_driver",
                        "label": "scout.cfg_driver",
                        "type": "select",
                        "options": {
                            "database": "scout.cfg_db",
                            "collection": "scout.cfg_mem",
                            "meilisearch": "scout.cfg_meili_opt"
                        }
                    },
                    {
                        "name": "scout_meili_host",
                        "label": "scout.cfg_meili_host",
                        "type": "text",
                        "placeholder": "http://127.0.0.1:7700"
                    },
                    {
                        "name": "scout_meili_key",
                        "label": "scout.cfg_meili_key",
                        "type": "text",
                        "hint": "scout.cfg_meili_hint"
                    }
                ]
            }
        },
        "modules": {
            "scout": {
                "title": "全文搜索",
                "hint": "Laravel Scout：开关、驱动、重建索引。",
                "view": "scout::admin.board",
                "handler": "Plugins\\Scout\\Services\\ScoutAdmin",
                "desks": ["settings"],
                "default_desk": "settings",
                "fields": [],
                "cols": ["id"]
            }
        },
        "sidebar_fold": {
            "site": [
                {
                    "url": "/admin/video/scout",
                    "icon": "search",
                    "label": "nav.scout"
                },
                {
                    "url": "/admin/video/config/scout",
                    "icon": "sliders-h",
                    "label": "nav.scout_config"
                }
            ]
        },
        "catalog": {
            "more.complete": [
                {
                    "url": "/admin/video/scout",
                    "label": "item.scout",
                    "hint": "hint.scout",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {
                "url": "/admin/video/config/scout",
                "label": "item.config_scout"
            }
        ]
    }
}
