                        ]
                    },
                    {
                        "name": "note",
                        "label": "备注",
                        "type": "text"
                    }
                ],
                "cols": [
                    "id",
                    "name",
                    "url",
                    "status",
                    "note"
                ]
            }
        },
        "catalog": {
            "more.collect": [
