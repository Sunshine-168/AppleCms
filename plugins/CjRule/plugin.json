{
    "id": "cj_rule",
    "name": "自定义采集规则",
    "name_en": "Custom collect rules",
    "description": "可保存列表/标题规则。执行器没有接上，入库请用接口采集。",
    "description_en": "Stores list/title rules. The crawler is not wired; use API collect.",
    "version": "1.0.0",
    "enabled": false,
    "capability": "stub",
    "group": "collect",
    "admin": {
        "modules": {
            "cj": {
                "title": "自定义规则",
