{
    "id": "cj_rule",
    "name": "自定义采集规则",
    "name_en": "Custom collect rules",
    "description": "按列表/标题/地址正则抓 HTML 入库。试跑不写库；规则不合法或抓取失败会报错。",
    "description_en": "Fetch HTML with list/title/url regex. Try-run does not import. Bad rules fail.",
    "version": "1.1.0",
    "enabled": false,
    "capability": "ready",
    "group": "collect",
    "provider": "Plugins\\CjRule\\CjRuleServiceProvider",
    "admin": {
        "modules": {
            "cj": {
                "title": "自定义规则",
                "hint": "列表页 URL + 正则。试跑只看前几条；入库按标题去重，没有播放地址的写成草稿。",
                "model": "App\\Models\\Video\\VideoCjRule",
                "search": "name",
                "fields": [
                    {"name": "name", "label": "名称", "type": "text"},
                    {"name": "url", "label": "列表地址", "type": "text"},
                    {"name": "list_rule", "label": "列表规则", "type": "text"},
                    {"name": "title_rule", "label": "标题规则", "type": "text"},
                    {"name": "url_rule", "label": "地址规则", "type": "text"},
                    {"name": "content_rule", "label": "简介规则", "type": "text"},
                    {"name": "type_id", "label": "分类ID", "type": "number"},
                    {"name": "status", "label": "状态", "type": "select", "options": {"0": "停用", "1": "启用"}},
                    {"name": "note", "label": "备注", "type": "text"}
                ],
                "cols": ["id", "name", "url", "status", "note"]
            }
        },
        "sidebar_fold": {
            "content": [
                {"url": "/admin/video/cj", "icon": "spider", "label": "nav.cj"}
            ]
        },
        "catalog": {
            "more.collect": [
                {"url": "/admin/video/cj", "label": "item.cj", "hint": "hint.cj", "tag": "plugin"}
            ]
        }
    }
}
