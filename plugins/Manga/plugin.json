{
    "id": "manga",
    "name": "漫画",
    "name_en": "Manga",
    "description": "独立漫画库和阅读页。关掉后 /manga 和后台入口一起消失。不是影片分类。",
    "description_en": "Standalone manga library and reader. /manga and admin entries leave when you turn it off. Not a video category.",
    "version": "1.6.5",
    "enabled": true,
    "capability": "ready",
    "group": "content",
    "provider": "Plugins\\Manga\\MangaServiceProvider",
    "admin": {
        "extra_pages": {
            "manga": {
                "title": "item.config_manga",
                "hint": "manga.cfg_hint",
                "fields": [
                    {
                        "name": "manga_collect_audit",
                        "label": "manga.cfg_audit",
                        "type": "select",
                        "options": [
                            "manga.cfg_audit_no",
                            "manga.cfg_audit_yes"
                        ]
                    },
                    {
                        "name": "manga_trysee_pages",
                        "label": "manga.cfg_trysee",
                        "type": "text",
                        "hint": "manga.cfg_trysee_hint"
                    },
                    {
                        "name": "manga_vip_group_ids",
                        "label": "manga.cfg_vip_group",
                        "type": "text",
                        "hint": "manga.cfg_vip_hint"
                    },
                    {
                        "name": "manga_collect_localize",
                        "label": "manga.cfg_localize",
                        "type": "select",
                        "options": [
                            "manga.cfg_loc_no",
                            "manga.cfg_loc_yes"
                        ]
                    }
                ]
            }
        },
        "modules": {
            "mangas": {
                "title": "漫画",
                "hint": "独立漫画库，不是影片分类。点作品「管理」进工作台；统计含人气/收藏/阅读趋势。",
                "model": "Plugins\\Manga\\Models\\Manga",
                "search": "title",
                "view": "manga::admin.board",
                "handler": "Plugins\\Manga\\Services\\MangaAdmin",
                "desks": [
                    "works",
                    "pending",
                    "types",
                    "work",
                    "chapters",
                    "pics",
                    "comments",
                    "favors",
                    "stats"
                ],
                "default_desk": "works",
                "fields": [
                    {
                        "name": "title",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "cover",
                        "label": "封面",
                        "type": "text"
                    },
                    {
                        "name": "author",
                        "label": "作者",
                        "type": "text"
                    },
                    {
                        "name": "type_id",
                        "label": "分类",
                        "type": "number"
                    },
                    {
                        "name": "serialize",
                        "label": "连载",
                        "type": "select",
                        "options": [
                            "连载",
                            "完结"
                        ]
                    },
                    {
                        "name": "tags",
                        "label": "标签",
                        "type": "text"
                    },
                    {
                        "name": "recommend",
                        "label": "推荐",
                        "type": "select",
                        "options": [
                            "否",
                            "是"
                        ]
                    },
                    {
                        "name": "yid",
                        "label": "审核",
                        "type": "select",
                        "options": [
                            "已审",
                            "待审"
                        ]
                    },
                    {
                        "name": "remarks",
                        "label": "备注",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "简介",
                        "type": "textarea"
                    },
                    {
                        "name": "hits",
                        "label": "人气",
                        "type": "number"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "上架",
                            "0": "下架"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "title",
                    "author",
                    "remarks",
                    "hits",
                    "status",
                    "sort"
                ]
            },
            "manga_authors": {
                "title": "漫画作者",
                "hint": "漫画作者库，不是会员或影人。",
                "model": "Plugins\\Manga\\Models\\MangaAuthor",
                "search": "name",
                "redirect": "/admin/video/manga-authors",
                "fields": [
                    {
                        "name": "name",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "slug",
                        "label": "别名",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "启用",
                            "0": "停用"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "name",
                    "slug",
                    "sort",
                    "status"
                ]
            },
            "manga_types": {
                "title": "漫画分类",
                "hint": "漫画自己的分类，不是影片分类。",
                "model": "Plugins\\Manga\\Models\\MangaType",
                "search": "name",
                "redirect": "/admin/video/manga-types",
                "fields": [
                    {
                        "name": "name",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "slug",
                        "label": "别名",
                        "type": "text"
                    },
                    {
                        "name": "pic",
                        "label": "封面",
                        "type": "text"
                    },
                    {
                        "name": "parent_id",
                        "label": "上级",
                        "type": "number"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "page_size",
                        "label": "分页",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "隐藏"
                        }
                    },
                    {
                        "name": "seo_title",
                        "label": "SEO标题",
                        "type": "text"
                    },
                    {
                        "name": "seo_keywords",
                        "label": "SEO关键词",
                        "type": "text"
                    },
                    {
                        "name": "seo_description",
                        "label": "SEO描述",
                        "type": "textarea"
                    }
                ],
                "cols": [
                    "id",
                    "name",
                    "slug",
                    "parent_id",
                    "sort",
                    "status"
                ]
            },
            "manga_chapters": {
                "title": "漫画章节",
                "hint": "图片地址每行一条，http(s) 或站内路径。",
                "model": "Plugins\\Manga\\Models\\MangaChapter",
                "search": "name",
                "redirect": "/admin/video/mangas?desk=chapters",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "name",
                        "label": "章节名",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "vip",
                        "label": "VIP",
                        "type": "select",
                        "options": [
                            "免费",
                            "VIP"
                        ]
                    },
                    {
                        "name": "pics",
                        "label": "图片地址",
                        "type": "textarea"
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "name",
                    "vip",
                    "sort"
                ]
            },
            "manga_pics": {
                "title": "漫画图片",
                "hint": "一话一张图一行。http(s) 或站内路径。",
                "model": "Plugins\\Manga\\Models\\MangaPic",
                "search": "url",
                "redirect": "/admin/video/mangas?desk=pics",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "chapter_id",
                        "label": "章节ID",
                        "type": "number"
                    },
                    {
                        "name": "url",
                        "label": "图片地址",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "chapter_id",
                    "url",
                    "sort"
                ]
            },
            "manga_comments": {
                "title": "漫画评论",
                "hint": "前台漫画页发来的评论。存在插件自己的表，不是影片评论。",
                "model": "Plugins\\Manga\\Models\\MangaComment",
                "search": "content",
                "redirect": "/admin/video/mangas?desk=comments",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "author_name",
                        "label": "昵称",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "内容",
                        "type": "textarea"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "待审 / 隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "author_name",
                    "content",
                    "status"
                ]
            },
            "manga_favors": {
                "title": "漫画书架",
                "hint": "会员在漫画页点的书架收藏。后台只查看和取消，不能代收藏。",
                "model": "Plugins\\Manga\\Models\\MangaFavor",
                "search": "id",
                "redirect": "/admin/video/mangas?desk=favors",
                "fields": [
                    {
                        "name": "member_id",
                        "label": "会员ID",
                        "type": "number"
                    },
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    }
                ],
                "cols": [
                    "id",
                    "member_id",
                    "manga_id",
                    "created_at"
                ]
            }
        },
        "sidebar_fold": {
            "manga": [
                {
                    "url": "/admin/video/mangas",
                    "icon": "book-open",
                    "label": "nav.manga_list"
                },
                {
                    "url": "/admin/video/mangas?desk=pending",
                    "icon": "clock",
                    "label": "nav.manga_pending"
                },
                {
                    "url": "/admin/video/manga-types",
                    "icon": "sitemap",
                    "label": "nav.manga_types"
                },
                {
                    "url": "/admin/video/manga-tags",
                    "icon": "tags",
                    "label": "nav.manga_tags"
                },
                {
                    "url": "/admin/video/manga-authors",
                    "icon": "user",
                    "label": "nav.manga_authors"
                },
                {
                    "url": "/admin/video/mangas?desk=comments",
                    "icon": "comments",
                    "label": "nav.manga_comments"
                },
                {
                    "url": "/admin/video/mangas?desk=favors",
                    "icon": "star",
                    "label": "nav.manga_favors"
                },
                {
                    "url": "/admin/video/mangas?desk=stats",
                    "icon": "chart-bar",
                    "label": "nav.manga_stats"
                },
                {
                    "url": "/admin/video/config/manga",
                    "icon": "sliders-h",
                    "label": "nav.manga_config"
                }
            ]
        },
        "catalog": {
            "more.complete": [
                {
                    "url": "/admin/video/mangas",
                    "label": "item.manga",
                    "hint": "hint.manga",
                    "tag": "plugin"
                },
                {
                    "url": "/admin/video/config/manga",
                    "label": "item.config_manga",
                    "hint": "hint.config_manga",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {
                "url": "/admin/video/config/manga",
                "label": "item.config_manga"
            }
        ]
    }
}
