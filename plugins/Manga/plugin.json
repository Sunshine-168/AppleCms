{
    "id": "manga",
    "name": "漫画",
    "name_en": "Manga",
    "description": "独立漫画库和阅读页。关掉后 /manga 和后台入口一起消失。不是影片分类。",
    "description_en": "Standalone manga library and reader. /manga and admin entries leave when you turn it off. Not a video category.",
    "version": "1.0.0",
    "enabled": true,
    "capability": "ready",
    "group": "content",
    "provider": "Plugins\\Manga\\MangaServiceProvider",
    "admin": {
        "modules": {
            "mangas": {
                "title": "漫画",
                "hint": "独立漫画库，不是影片分类。分类、章节、图片、评论都在这页切换。",
                "model": "Plugins\\Manga\\Models\\Manga",
                "search": "title",
                "view": "manga::admin.board",
                "desks": [
                    "works",
                    "pending",
                    "types",
                    "chapters",
                    "pics",
                    "comments"
                ],
                "default_desk": "works",
                "fields": [
                    {
                        "name": "title",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "cover",
                        "label": "封面",
                        "type": "text"
                    },
                    {
                        "name": "author",
                        "label": "作者",
                        "type": "text"
                    },
                    {
                        "name": "type_id",
                        "label": "分类",
                        "type": "number"
                    },
                    {
                        "name": "serialize",
                        "label": "连载",
                        "type": "select",
                        "options": [
                            "连载",
                            "完结"
                        ]
                    },
                    {
                        "name": "tags",
                        "label": "标签",
                        "type": "text"
                    },
                    {
                        "name": "recommend",
                        "label": "推荐",
                        "type": "select",
                        "options": [
                            "否",
                            "是"
                        ]
                    },
                    {
                        "name": "yid",
                        "label": "审核",
                        "type": "select",
                        "options": [
                            "已审",
                            "待审"
                        ]
                    },
                    {
                        "name": "remarks",
                        "label": "备注",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "简介",
                        "type": "textarea"
                    },
                    {
                        "name": "hits",
                        "label": "人气",
                        "type": "number"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "上架",
                            "0": "下架"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "title",
                    "author",
                    "remarks",
                    "hits",
                    "status",
                    "sort"
                ]
            },
            "manga_types": {
                "title": "漫画分类",
                "hint": "漫画自己的分类，不是影片分类。",
                "model": "Plugins\\Manga\\Models\\MangaType",
                "search": "name",
                "redirect": "/admin/video/mangas?desk=types",
                "fields": [
                    {
                        "name": "name",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "parent_id",
                        "label": "上级",
                        "type": "number"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "name",
                    "parent_id",
                    "sort",
                    "status"
                ]
            },
            "manga_chapters": {
                "title": "漫画章节",
                "hint": "图片地址每行一条，http(s) 或站内路径。",
                "model": "Plugins\\Manga\\Models\\MangaChapter",
                "search": "name",
                "redirect": "/admin/video/mangas?desk=chapters",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "name",
                        "label": "章节名",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "pics",
                        "label": "图片地址",
                        "type": "textarea"
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "name",
                    "sort"
                ]
            },
            "manga_pics": {
                "title": "漫画图片",
                "hint": "一话一张图一行。http(s) 或站内路径。",
                "model": "Plugins\\Manga\\Models\\MangaPic",
                "search": "url",
                "redirect": "/admin/video/mangas?desk=pics",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "chapter_id",
                        "label": "章节ID",
                        "type": "number"
                    },
                    {
                        "name": "url",
                        "label": "图片地址",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "chapter_id",
                    "url",
                    "sort"
                ]
            },
            "manga_comments": {
                "title": "漫画评论",
                "hint": "前台漫画页发来的评论。存在插件自己的表，不是影片评论。",
                "model": "Plugins\\Manga\\Models\\MangaComment",
                "search": "content",
                "redirect": "/admin/video/mangas?desk=comments",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "author_name",
                        "label": "昵称",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "内容",
                        "type": "textarea"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "待审 / 隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "author_name",
                    "content",
                    "status"
                ]
            }
        },
        "sidebar_fold": {
            "plugin": [
                {
                    "url": "/admin/video/mangas",
                    "icon": "book-open",
                    "label": "nav.manga",
                    "children": [
                        {
                            "url": "/admin/video/mangas",
                            "label": "nav.manga_list"
                        },
                        {
                            "url": "/admin/video/mangas?desk=pending",
                            "label": "nav.manga_pending"
                        },
                        {
                            "url": "/admin/video/mangas?desk=types",
                            "label": "nav.manga_types"
                        },
                        {
                            "url": "/admin/video/mangas?desk=chapters",
                            "label": "nav.manga_chapters"
                        },
                        {
                            "url": "/admin/video/mangas?desk=pics",
                            "label": "nav.manga_pics"
                        },
                        {
                            "url": "/admin/video/mangas?desk=comments",
                            "label": "nav.manga_comments"
                        }
                    ]
                }
            ]
        },
        "catalog": {
            "more.complete": [
                {
                    "url": "/admin/video/mangas",
                    "label": "item.manga",
                    "hint": "hint.manga",
                    "tag": "plugin"
                }
            ]
        }
    }
}
