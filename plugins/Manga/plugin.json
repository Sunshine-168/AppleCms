{
    "id": "manga",
    "name": "漫画",
    "name_en": "Manga",
    "description": "独立漫画库和阅读页。关掉后 /manga 和后台入口一起消失。不是影片分类。",
    "description_en": "Standalone manga library and reader. /manga and admin entries leave when you turn it off. Not a video category.",
    "version": "1.0.0",
    "enabled": true,
    "capability": "ready",
    "group": "content",
    "provider": "Plugins\\Manga\\MangaServiceProvider",
    "admin": {
        "modules": {
            "mangas": {
                "title": "漫画",
                "hint": "封面填图片地址。章节在「漫画章节」里加，一话一行图片。",
                "model": "Plugins\\Manga\\Models\\Manga",
                "search": "title",
                "fields": [
                    {
                        "name": "title",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "cover",
                        "label": "封面",
                        "type": "text"
                    },
                    {
                        "name": "author",
                        "label": "作者",
                        "type": "text"
                    },
                    {
                        "name": "remarks",
                        "label": "备注",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "简介",
                        "type": "textarea"
                    },
                    {
                        "name": "hits",
                        "label": "人气",
                        "type": "number"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "上架",
                            "0": "下架"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "title",
                    "author",
                    "remarks",
                    "hits",
                    "status",
                    "sort"
                ]
            },
            "manga_chapters": {
                "title": "漫画章节",
                "hint": "图片地址每行一条，http(s) 或站内路径。",
                "model": "Plugins\\Manga\\Models\\MangaChapter",
                "search": "name",
                "fields": [
                    {
                        "name": "manga_id",
                        "label": "漫画ID",
                        "type": "number"
                    },
                    {
                        "name": "name",
                        "label": "章节名",
                        "type": "text"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "pics",
                        "label": "图片地址",
                        "type": "textarea"
                    }
                ],
                "cols": [
                    "id",
                    "manga_id",
                    "name",
                    "sort"
                ]
            }
        },
        "sidebar_fold": {
            "content": [
                {
                    "url": "/admin/video/mangas",
                    "icon": "book-open",
                    "label": "nav.manga"
                },
                {
                    "url": "/admin/video/manga_chapters",
                    "icon": "list-ol",
                    "label": "nav.manga_chapters"
                }
            ]
        },
        "catalog": {
            "more.complete": [
                {
                    "url": "/admin/video/mangas",
                    "label": "item.manga",
                    "hint": "hint.manga",
                    "tag": "plugin"
                }
            ]
        }
    }
}
