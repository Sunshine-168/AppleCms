{
    "id": "mall",
    "name": "积分商城",
    "name_en": "Points mall",
    "name_zh_tw": "積分商城",
    "description": "用会员积分兑换会员时长、积分卡密或周边。不接微信支付宝。",
    "description_en": "Redeem points for VIP days, card packs, or merch. No WeChat/Alipay.",
    "description_zh_tw": "用會員積分兌換會員時長、積分卡密或周邊。不接微信支付寶。",
    "version": "1.2.0",
    "enabled": true,
    "capability": "ready",
    "group": "member",
    "provider": "Plugins\\Mall\\MallServiceProvider",
    "admin": {
        "modules": {
            "mall_goods": {
                "title": "积分商城",
                "hint": "用会员积分兑换会员时长、积分卡密或周边。不接微信支付宝。",
                "model": "Plugins\\Mall\\Models\\MallGood",
                "search": "name",
                "view": "mall::admin.board",
                "desks": ["goods", "orders", "ship"],
                "default_desk": "goods",
                "fields": [
                    {
                        "name": "name",
                        "label": "名称",
                        "type": "text"
                    },
                    {
                        "name": "type",
                        "label": "类型",
                        "type": "select",
                        "options": {
                            "vip": "会员时长",
                            "card": "积分卡密",
                            "goods": "实物周边"
                        }
                    },
                    {
                        "name": "cover",
                        "label": "封面",
                        "type": "text"
                    },
                    {
                        "name": "points",
                        "label": "积分",
                        "type": "number"
                    },
                    {
                        "name": "stock",
                        "label": "库存",
                        "type": "number"
                    },
                    {
                        "name": "is_hot",
                        "label": "热门",
                        "type": "select",
                        "options": {
                            "0": "否",
                            "1": "是"
                        }
                    },
                    {
                        "name": "hint",
                        "label": "说明",
                        "type": "textarea"
                    },
                    {
                        "name": "sort",
                        "label": "排序",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "上架",
                            "0": "下架"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "name",
                    "type",
                    "points",
                    "stock",
                    "sales",
                    "is_hot",
                    "status",
                    "sort"
                ]
            },
            "mall_orders": {
                "title": "商城订单",
                "hint": "会员兑换记录。实物改成已发货即完成。会员时长和卡密兑换当时就完成。",
                "model": "Plugins\\Mall\\Models\\MallOrder",
                "search": "goods_name",
                "redirect": "/admin/video/mall_goods?desk=orders",
                "fields": [
                    {
                        "name": "member_id",
                        "label": "会员ID",
                        "type": "number"
                    },
                    {
                        "name": "goods_id",
                        "label": "商品ID",
                        "type": "number"
                    },
                    {
                        "name": "goods_name",
                        "label": "商品名",
                        "type": "text"
                    },
                    {
                        "name": "points",
                        "label": "积分",
                        "type": "number"
                    },
                    {
                        "name": "contact",
                        "label": "联系方式",
                        "type": "text"
                    },
                    {
                        "name": "address",
                        "label": "收货备注",
                        "type": "text"
                    },
                    {
                        "name": "remark",
                        "label": "备注",
                        "type": "text"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "待发货",
                            "2": "已完成"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "member_id",
                    "goods_name",
                    "points",
                    "status",
                    "created_at"
                ]
            }
        },
        "sidebar_fold": {
            "users": [
                {
                    "url": "/admin/video/mall_goods",
                    "icon": "store",
                    "label": "nav.mall",
                    "children": [
                        {"url": "/admin/video/mall_goods", "label": "nav.mall_goods"},
                        {"url": "/admin/video/mall_goods?desk=orders", "label": "nav.mall_orders"},
                        {"url": "/admin/video/mall_goods?desk=ship", "label": "nav.mall_ship"}
                    ]
                }
            ]
        },
        "catalog": {
            "more.member": [
                {
                    "url": "/admin/video/mall_goods",
                    "label": "item.mall",
                    "hint": "hint.mall",
                    "tag": "plugin"
                }
            ]
        }
    }
}
