{
    "id": "danmaku",
    "name": "弹幕",
    "name_en": "Danmaku",
    "description": "播放页发送和滚动弹幕，后台可审。已接通前台。",
    "description_en": "Send and scroll comments on the player. Front-end is wired.",
    "version": "1.1.0",
    "enabled": true,
    "capability": "ready",
    "group": "play",
    "provider": "Plugins\\Danmaku\\DanmakuServiceProvider",
    "admin": {
        "extra_pages": {
            "danmaku": {
                "title": "item.config_danmaku",
                "hint": "danmaku.cfg_hint",
                "fields": [
                    {
                        "name": "danmaku_enabled",
                        "label": "danmaku.cfg_on",
                        "type": "select",
                        "options": {
                            "1": "ui.on_switch",
                            "0": "ui.off_switch"
                        }
                    },
                    {
                        "name": "danmaku_login",
                        "label": "danmaku.cfg_login",
                        "type": "select",
                        "options": {
                            "0": "ui.no",
                            "1": "ui.yes"
                        }
                    }
                ]
            }
        },
        "modules": {
            "danmaku": {
                "title": "弹幕",
                "hint": "播放器滚动弹幕。后台只审显示、隐藏或删除，不能手添。",
                "model": "Plugins\\Danmaku\\Models\\Danmaku",
                "search": "text",
                "view": "danmaku::admin.board",
                "handler": "Plugins\\Danmaku\\Services\\DanmakuAdmin",
                "desks": ["messages", "settings"],
                "default_desk": "messages",
                "fields": [
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "video_id",
                    "episode_id",
                    "text",
                    "mode",
                    "time",
                    "report",
                    "status"
                ]
            }
        },
        "sidebar_fold": {
            "content": [
                {
                    "url": "/admin/video/danmaku",
                    "icon": "comment-dots",
                    "label": "nav.danmaku"
                }
            ]
        },
        "catalog": {
            "more.interact": [
                {
                    "url": "/admin/video/danmaku",
                    "label": "item.danmaku",
                    "hint": "hint.danmaku",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {
                "url": "/admin/video/danmaku?desk=settings",
                "label": "item.config_danmaku"
            }
        ]
    }
}
