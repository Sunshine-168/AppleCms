{
    "id": "danmaku",
    "name": "弹幕",
    "name_en": "Danmaku",
    "description": "播放页发送和滚动弹幕，后台可审。已接通前台。",
    "description_en": "Send and scroll comments on the player. Front-end is wired.",
    "version": "1.0.0",
    "enabled": false,
    "capability": "ready",
    "group": "play",
    "provider": "Plugins\\Danmaku\\DanmakuServiceProvider",
    "admin": {
        "extra_pages": {
            "danmaku": {
                "title": "弹幕参数",
                "hint": "关闭后播放器不再加载弹幕层。",
                "fields": [
                    {
                        "name": "danmaku_enabled",
                        "label": "弹幕",
                        "type": "select",
                        "options": {
                            "1": "开启",
                            "0": "关闭"
                        }
                    },
                    {
                        "name": "danmaku_login",
                        "label": "发送需登录",
                        "type": "select",
                        "options": [
                            "否",
                            "是"
                        ]
                    }
                ]
            }
        },
        "modules": {
            "danmaku": {
                "title": "弹幕管理",
                "model": "Plugins\\Danmaku\\Models\\Danmaku",
                "search": "text",
                "fields": [
                    {
                        "name": "video_id",
                        "label": "影片ID",
                        "type": "number"
                    },
                    {
                        "name": "episode_id",
                        "label": "分集ID",
                        "type": "number"
                    },
                    {
                        "name": "text",
                        "label": "内容",
                        "type": "textarea"
                    },
                    {
                        "name": "color",
                        "label": "颜色",
                        "type": "text"
                    },
                    {
                        "name": "time",
                        "label": "秒",
                        "type": "text"
                    },
                    {
                        "name": "status",
                        "label": "状态",
                        "type": "select",
                        "options": {
                            "1": "显示",
                            "0": "隐藏"
                        }
                    }
                ],
                "cols": [
                    "id",
                    "video_id",
                    "episode_id",
                    "text",
                    "time",
                    "ip",
                    "status"
                ]
            }
        },
        "sidebar_fold": {
            "content": [
                {
                    "url": "/admin/video/danmaku",
                    "icon": "comment-dots",
                    "label": "nav.danmaku"
                }
            ]
        },
        "settings_links": [
            {
                "url": "/admin/video/config/danmaku",
                "label": "item.config_danmaku"
            }
        ]
    }
}
