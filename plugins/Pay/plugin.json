{
    "id": "pay",
    "name": "在线支付",
    "name_en": "Online pay",
    "description": "会员中心下单，微信 Native / 支付宝电脑网站支付。回调验签后加积分，没配密钥会失败。",
    "description_en": "Create orders from the member center. WeChat Native and Alipay page pay credit points after a verified notify. Empty keys fail.",
    "version": "1.1.0",
    "enabled": true,
    "capability": "ready",
    "group": "pay",
    "provider": "Plugins\\Pay\\PayServiceProvider",
    "admin": {
        "extra_pages": {
            "pay": {
                "title": "支付参数",
                "hint": "配齐后会员中心可以付钱。微信走 Native 扫码，支付宝走电脑网站支付。回调地址见会员中心说明。密钥留空会下单失败，后台仍可补录已付。",
                "fields": [
                    {"name": "pay_wechat_appid", "label": "微信 AppId", "type": "text"},
                    {"name": "pay_wechat_mchid", "label": "微信商户号", "type": "text"},
                    {"name": "pay_wechat_key", "label": "微信 API 密钥", "type": "text"},
                    {"name": "pay_alipay_appid", "label": "支付宝 AppId", "type": "text"},
                    {"name": "pay_alipay_key", "label": "支付宝 RSA 私钥", "type": "textarea", "placeholder": "PKCS8，含 BEGIN 或纯 Base64"},
                    {"name": "pay_alipay_public", "label": "支付宝公钥", "type": "textarea", "placeholder": "验签用，没有则支付宝回调会拒绝"}
                ]
            }
        },
        "catalog": {
            "more.member": [
                {
                    "url": "/admin/video/config/pay",
                    "label": "item.config_pay",
                    "hint": "hint.config_pay",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {"url": "/admin/video/config/pay", "label": "item.config_pay"}
        ]
    }
}
