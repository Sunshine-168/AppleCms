{
    "id": "pay",
    "name": "在线支付",
    "name_en": "Online pay",
    "description": "会员充值：微信 / 支付宝官方，以及可对接的易支付、DfPay 聚合通道。回调验签后加积分。",
    "description_en": "Member recharge via WeChat/Alipay or pluggable Epay/DfPay gateways. Points credit after verified notify.",
    "version": "1.3.1",
    "enabled": true,
    "capability": "ready",
    "group": "pay",
    "provider": "Plugins\\Pay\\PayServiceProvider",
    "admin": {
        "modules": {
            "pay_channels": {
                "title": "支付通道",
                "hint": "易支付 / DfPay。通道页对接网关；统计页看实收。会员可用订单号查询自己的单。",
                "model": "Plugins\\Pay\\Models\\PayChannel",
                "search": "title",
                "view": "pay::admin.channels",
                "handler": "Plugins\\Pay\\Services\\PayChannelAdmin",
                "desks": ["channels", "stats"],
                "default_desk": "channels",
                "fields": [
                    {"name": "title", "label": "名称", "type": "text"},
                    {"name": "driver", "label": "驱动", "type": "select", "options": {"epay": "易支付", "dfpay": "DfPay"}},
                    {"name": "code", "label": "产品码", "type": "text"},
                    {"name": "api_url", "label": "网关", "type": "text"},
                    {"name": "mch_id", "label": "商户号", "type": "text"},
                    {"name": "status", "label": "状态", "type": "select", "options": {"1": "启用", "0": "停用"}}
                ],
                "cols": ["id", "title", "driver", "code", "mch_id", "status", "sort"]
            }
        },
        "extra_pages": {
            "pay": {
                "title": "item.config_pay",
                "hint": "pay.cfg_hint",
                "fields": [
                    {"name": "pay_wechat_appid", "label": "pay.cfg_wx_appid", "type": "text"},
                    {"name": "pay_wechat_mchid", "label": "pay.cfg_wx_mch", "type": "text"},
                    {"name": "pay_wechat_key", "label": "pay.cfg_wx_key", "type": "text"},
                    {"name": "pay_alipay_appid", "label": "pay.cfg_ali_appid", "type": "text"},
                    {"name": "pay_alipay_key", "label": "pay.cfg_ali_key", "type": "textarea", "placeholder": "pay.cfg_ali_key_ph"},
                    {"name": "pay_alipay_public", "label": "pay.cfg_ali_pub", "type": "textarea", "placeholder": "pay.cfg_ali_pub_ph"}
                ]
            }
        },
        "sidebar_fold": {
            "users": [
                {
                    "url": "/admin/video/pay_channels",
                    "icon": "credit-card",
                    "label": "nav.pay_channels"
                }
            ]
        },
        "catalog": {
            "more.member": [
                {
                    "url": "/admin/video/config/pay",
                    "label": "item.config_pay",
                    "hint": "hint.config_pay",
                    "tag": "plugin"
                },
                {
                    "url": "/admin/video/pay_channels",
                    "label": "item.pay_channels",
                    "hint": "hint.pay_channels",
                    "tag": "plugin"
                }
            ]
        },
        "settings_links": [
            {"url": "/admin/video/config/pay", "label": "item.config_pay"},
            {"url": "/admin/video/pay_channels", "label": "item.pay_channels"}
        ]
    }
}
