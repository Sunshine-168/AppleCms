{
    "id": "member_social",
    "name": "会员互动",
    "name_en": "Member social",
    "name_zh_tw": "會員互動",
    "description": "关注、动态、分享有数据表和后台增删改。签到已归核心用户活动。复制链接会写分享记录。",
    "description_en": "Follow, feed and share tables exist. Check-in moved to core user activity. Copy-link writes a share row.",
    "description_zh_tw": "關注、動態、分享有資料表和後台增刪改。簽到已歸核心用戶活動。複製連結會寫分享記錄。",
    "version": "1.0.1",
    "enabled": true,
    "capability": "stub",
    "group": "member",
    "admin": {
        "modules": {
            "follows": {
                "title": "关注",
                "hint": "仅后台记录，前台没有关注按钮。",
                "model": "App\\Models\\Member\\MemberFollow",
                "search": "target_type",
                "fields": [
                    {
                        "name": "member_id",
                        "label": "会员ID",
                        "type": "number"
                    },
                    {
                        "name": "target_id",
                        "label": "对象ID",
                        "type": "number"
                    },
                    {
                        "name": "target_type",
                        "label": "类型 actor/user",
                        "type": "text"
                    }
                ],
                "cols": [
                    "id",
                    "member_id",
                    "target_type",
                    "target_id",
                    "created_at"
                ]
            },
            "dynamics": {
                "title": "动态",
                "hint": "仅后台记录，没有会员动态流。",
                "model": "App\\Models\\Member\\MemberDynamic",
                "search": "content",
                "fields": [
                    {
                        "name": "member_id",
                        "label": "会员ID",
                        "type": "number"
                    },
                    {
                        "name": "type",
                        "label": "类型",
                        "type": "text"
                    },
                    {
                        "name": "content",
                        "label": "内容",
                        "type": "textarea"
                    },
                    {
                        "name": "video_id",
                        "label": "影片ID",
                        "type": "number"
                    }
                ],
                "cols": [
                    "id",
                    "member_id",
                    "type",
                    "content",
                    "video_id",
                    "created_at"
                ]
            },
            "shares": {
                "title": "分享记录",
                "hint": "前台复制链接会记一条，不是微信分享。",
                "model": "App\\Models\\Member\\MemberShare",
                "search": "channel",
                "fields": [
                    {
                        "name": "member_id",
                        "label": "会员ID",
                        "type": "number"
                    },
                    {
                        "name": "video_id",
                        "label": "影片ID",
                        "type": "number"
                    },
                    {
                        "name": "channel",
                        "label": "渠道",
                        "type": "text"
                    },
                    {
                        "name": "ip",
                        "label": "IP",
                        "type": "text"
                    }
                ],
                "cols": [
                    "id",
                    "member_id",
                    "video_id",
                    "channel",
                    "ip",
                    "created_at"
                ]
            }
        },
        "catalog": {
            "more.member": [
                {
                    "url": "/admin/video/follows",
                    "label": "item.follows",
                    "hint": "hint.follows",
                    "tag": "plugin"
                },
                {
                    "url": "/admin/video/dynamics",
                    "label": "item.dynamics",
                    "hint": "hint.dynamics",
                    "tag": "plugin"
                },
                {
                    "url": "/admin/video/shares",
                    "label": "item.shares",
                    "hint": "hint.shares",
                    "tag": "plugin"
                }
            ]
        }
    }
}
